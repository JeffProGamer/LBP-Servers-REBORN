@page "/photos/{pageNumber:int}"
@using LBPUnion.ProjectLighthouse.Localization.StringLists
@using LBPUnion.ProjectLighthouse.Servers.Website.Extensions
@using LBPUnion.ProjectLighthouse.Types.Entities.Profile
@model LBPUnion.ProjectLighthouse.Servers.Website.Pages.PhotosPage

@{
    Layout = "Layouts/BaseLayout";
    Model.Title = Model.Translate(BaseLayoutStrings.HeaderPhotos);

    string language = Model.GetLanguage();
    string timeZone = Model.GetTimeZone();

    string searchQuery = string.IsNullOrWhiteSpace(Model.SearchValue)
        ? ""
        : $"?name={Model.SearchValue}";

    bool hasPrevious = Model.PageNumber > 0;
    bool hasNext = Model.PageNumber < Model.PageAmount - 1;
}

<section class="browse-hero photos">
    <div>
        <p class="eyebrow">Photos</p>
        <h1>@Model.Title</h1>
    </div>
    <span class="hero-count">@Model.PhotoCount total</span>
</section>

<section class="search-panel">
    <form action="/photos/0" method="get">
        <label class="visually-hidden" for="photo-search">Search photos</label>
        <input
            id="photo-search"
            type="text"
            autocomplete="off"
            name="name"
            placeholder="Search photos..."
            value="@Model.SearchValue" />
        <button type="submit" class="website-action primary compact">
            <i class="search icon"></i>
            Search
        </button>
    </form>
</section>

@if (Model.Photos.Count == 0)
{
    <section class="empty-state">
        <i class="camera icon"></i>
        <p>No photos found matching your search.</p>
    </section>
}
else
{
    <section class="photo-list">
        @foreach (PhotoEntity photo in Model.Photos)
        {
            bool canDelete = Model.User?.IsModerator == true ||
                             Model.User?.UserId == photo.CreatorId;

            <div class="ui segment">
                @await photo.ToHtml(
                    Html,
                    ViewData,
                    language,
                    timeZone,
                    canDelete
                )
            </div>
        }
    </section>
}

<nav class="pager" aria-label="Photo pages">

    @if (hasPrevious)
    {
        <a href="/photos/@(Model.PageNumber - 1)@searchQuery">
            <i class="angle left icon"></i>
            Previous
        </a>
    }

    <span class="pager-current">Page @(Model.PageNumber + 1) of @Model.PageAmount</span>

    @if (hasNext)
    {
        <a href="/photos/@(Model.PageNumber + 1)@searchQuery">
            Next
            <i class="angle right icon"></i>
        </a>
    }

</nav>
