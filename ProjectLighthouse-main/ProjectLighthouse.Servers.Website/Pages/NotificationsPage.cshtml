@page "/notifications"
@using LBPUnion.ProjectLighthouse.Localization.StringLists
@using LBPUnion.ProjectLighthouse.Types.Entities.Notifications
@using LBPUnion.ProjectLighthouse.Types.Entities.Website
@model LBPUnion.ProjectLighthouse.Servers.Website.Pages.NotificationsPage
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "Layouts/BaseLayout";
    Model.Title = Model.Translate(GeneralStrings.Notifications);

    var user = Model.User;
    bool isAdmin = user?.IsAdmin == true;
}

@if (isAdmin)
{
    <section class="website-panel announcement-composer">
        <div class="panel-header">
            <div>
                <span class="panel-kicker">Admin</span>
                <h2><i class="bullhorn icon"></i> Post New Announcement</h2>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            @await Html.PartialAsync(
                "Partials/ErrorModalPartial",
                (Model.Translate(GeneralStrings.Error), Model.Error),
                ViewData
            )
        }

        <form method="POST" class="ui form" action="/notifications">
            @Html.AntiForgeryToken()

            <div class="field">
                <label for="title">Announcement Title</label>
                <input type="text" name="title" id="title" required>
            </div>

            <div class="field">
                <label for="content">Announcement Content</label>
                <textarea
                    name="content"
                    id="content"
                    spellcheck="false"
                    rows="4"
                    required></textarea>
            </div>

            <button class="ui green button" type="submit">
                <i class="paper plane icon"></i>
                Post Announcement
            </button>
        </form>
    </section>
}

<div class="section-stack">
    @foreach (var announcement in Model.Announcements)
    {
        <section class="ui blue segment notification-card">
            <h3>@announcement.Title</h3>

            <p>@announcement.Content</p>

            @if (announcement.Publisher != null)
            {
                <div class="ui tiny label">
                    Posted by
                    <a href="~/user/@announcement.Publisher.UserId">
                        @announcement.Publisher.Username
                    </a>
                </div>
            }

            @if (isAdmin)
            {
                <form method="post">
                    @Html.AntiForgeryToken()

                    <button
                        asp-page-handler="delete"
                        asp-route-type="announcement"
                        asp-route-id="@announcement.AnnouncementId"
                        onclick="return confirm('Delete this announcement?')"
                        class="ui red icon button notification-action">
                        <i class="trash icon"></i>
                    </button>
                </form>
            }
        </section>
    }

    @if (user == null)
    {
        <section class="ui blue segment">
            <p>
                You need to <a href="/login">log in</a> to view notifications.
            </p>
        </section>
    }
    else if (Model.Notifications.Count == 0)
    {
        <section class="ui blue segment">
            <p>No new notifications.</p>
        </section>
    }
    else
    {
        @foreach (var notification in Model.Notifications)
        {
            <section class="ui blue segment notification-card">
                <i class="bell icon"></i>
                <span>@notification.Text</span>

                <form method="post">
                    @Html.AntiForgeryToken()

                    <button
                        asp-page-handler="delete"
                        asp-route-type="notification"
                        asp-route-id="@notification.Id"
                        onclick="return confirm('Mark as read?')"
                        class="ui green icon button notification-action">
                        <i class="check icon"></i>
                    </button>
                </form>
            </section>
        }
    }
</div>
