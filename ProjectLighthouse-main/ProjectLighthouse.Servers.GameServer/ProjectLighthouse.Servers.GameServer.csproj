<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        
        <!-- Clean and recommended names -->
        <AssemblyName>ProjectLighthouse.Servers.GameApi</AssemblyName>
        <RootNamespace>ProjectLighthouse.Servers.GameApi</RootNamespace>
        
        <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591;CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\ProjectLighthouse\ProjectLighthouse.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="textureGuids.txt" />
    </ItemGroup>

</Project>